# Copy these variables into Hostinger Docker Manager environment variables.
# Do NOT commit a real .env file with secrets.

# Postgres / NocoDB secrets
POSTGRES_DB=nocodb
POSTGRES_USER=nocodb
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_SECRET
NC_AUTH_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Public CRM URL routed by Traefik + Cloudflare
CRM_DOMAIN=crm.example.com
NC_PUBLIC_URL=https://crm.example.com

# Traefik settings used by Hostinger / your reverse proxy stack
TRAEFIK_ENABLE=true
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare

# Local debug binding only: 127.0.0.1:NOCODB_PORT -> container 8080
NOCODB_PORT=8080
