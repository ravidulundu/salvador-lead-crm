# Copy these variables into Hostinger Docker Manager environment variables.
# Do NOT commit a real .env file with secrets.

POSTGRES_DB=nocodb
POSTGRES_USER=nocodb
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_SECRET
NC_AUTH_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Example for your domain:
# CRM_DOMAIN=crm.dulunduztec.com.br
# NC_PUBLIC_URL=https://crm.dulunduztec.com.br
CRM_DOMAIN=crm.dulunduztec.com.br
NC_PUBLIC_URL=https://crm.dulunduztec.com.br
